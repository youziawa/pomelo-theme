// ===================================
// Pomelo Theme — Code Block (Terminal Style)
// ===================================
@import '_variables'
@import '_acrylic'

// Outer container mixin (shared by both simple pre and .highlight)
code-block-shell()
  position: relative
  margin: $space-md 0 0
  padding-top: 28px
  border-radius: $radius-lg
  overflow-x: auto
  overflow-y: hidden
  acrylic-card()
  acrylic-tint-terminal()
  acrylic-edge-highlight()
  border-bottom: 1px solid rgba(255, 255, 255, 0.05)

  &::after
    content: ""
    position: absolute
    top: 0
    left: 0
    right: 0
    height: 28px
    background: rgba(8, 8, 15, 0.5)
    background-image:
      radial-gradient(circle, #FF5F57 6px, transparent 6px),
      radial-gradient(circle, #FEBC2E 6px, transparent 6px),
      radial-gradient(circle, #28C840 6px, transparent 6px)
    background-size: 12px 12px
    background-position: 8px center, 28px center, 48px center
    background-repeat: no-repeat

// Code text styling
code-block-text()
  font-family: $font-code
  font-size: 14px
  line-height: $line-height-code
  color: $clr-text
  background: transparent
  white-space: pre

// ── Simple code blocks (no language / no line numbers) ──
.pt-post__content > pre
  code-block-shell()

  > code
    display: block
    position: relative
    z-index: 1
    padding: $space-md $space-lg $space-xs
    code-block-text()

// ── Highlighted code blocks (with language → line numbers) ──
.pt-post__content .highlight
  code-block-shell()

  .code-lang
    position: absolute
    top: -1px
    right: $space-lg
    font-size: 11px
    font-family: $font-code
    color: $clr-primary
    background: rgba(0, 255, 200, 0.08)
    border: 1px solid rgba(0, 255, 200, 0.2)
    border-top: none
    border-radius: 0 0 $radius-sm $radius-sm
    padding: 2px $space-sm
    z-index: 2
    letter-spacing: 0.5px
    text-transform: uppercase

  table
    position: relative
    z-index: 1
    margin: 0
    border-collapse: collapse
    width: 100%

  td
    padding: 0
    border: 0
    vertical-align: top

  .gutter
    width: 3em
    padding-right: $space-md
    text-align: right
    user-select: none
    color: $clr-text-disabled
    font-size: $font-scale-xs
    border-right: 1px solid rgba(255, 255, 255, 0.06)

    pre
      margin: 0
      padding: $space-md 0 $space-sm
      code-block-text()

  .code
    padding-left: $space-md

    pre, code
      margin: 0
      padding: $space-md $space-lg $space-sm
      code-block-text()

// Copy button
.code-copy-btn
  position: absolute
  top: 2px
  right: $space-md
  height: 24px
  padding: 0 $space-sm
  font-size: 11px
  line-height: 1
  color: $clr-text-secondary
  background: rgba(255, 255, 255, 0.06)
  border: 1px solid rgba(255, 255, 255, 0.08)
  border-radius: $radius-sm
  cursor: pointer
  opacity: 0.72
  transition: all $transition-fast
  z-index: 1
  font-family: $font-body

  .highlight:hover &,
  .pt-post__content > pre:hover &
    opacity: 1

  &:hover
    background: rgba(255, 255, 255, 0.12)
    color: $clr-text

  &.copied
    color: $clr-primary
    border-color: rgba(0, 255, 200, 0.3)
    background: rgba(0, 255, 200, 0.1)

.code-collapse-btn
  position: absolute
  top: 2px
  right: $space-3xl
  display: flex
  align-items: center
  justify-content: center
  width: 24px
  height: 24px
  padding: 0
  border: 1px solid rgba(255, 255, 255, 0.08)
  border-radius: $radius-sm
  color: $clr-text-secondary
  background: rgba(255, 255, 255, 0.06)
  cursor: pointer
  opacity: 0.72
  transition: background $transition-fast, border-color $transition-fast, color $transition-fast, transform $transition-fast, opacity $transition-fast
  z-index: 1

  svg
    width: 15px
    height: 15px

  .highlight:hover &,
  .pt-post__content > pre:hover &
    opacity: 1

  &:hover,
  &:focus-visible
    border-color: rgba($clr-primary, 0.35)
    background: rgba($clr-primary, 0.1)
    color: $clr-primary
    outline: none

  &.is-collapsed
    transform: rotate(-90deg)

.pt-post__content .highlight.is-collapsed table,
.pt-post__content > pre.is-collapsed > code
  display: none

.pt-post__content .highlight.is-collapsed,
.pt-post__content > pre.is-collapsed
  min-height: 28px

// Inline code in content
.pt-post__content
  code:not(pre code)
    font-family: $font-code
    font-size: 0.875em
    padding: 0.15em 0.5em
    border-radius: $radius-sm
    background: rgba(0, 255, 200, 0.08)
    color: $clr-primary
    font-feature-settings: "liga" 1
    border: 1px solid rgba(0, 255, 200, 0.1)
