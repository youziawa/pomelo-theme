// ===================================
// Pomelo Theme — Responsive (imported LAST to override all)
// ===================================
@import '_variables'

// ▼ Narrow (≤1024px): sidebar drops below, cards fill viewport
@media (max-width: 1024px)
  .pt-main
    width: 100% !important
    max-width: 100% !important
    padding-left: 0 !important
    padding-right: 0 !important

  .pt-header__inner,
  .pt-footer__inner
    padding-left: $space-md !important
    padding-right: $space-md !important

  .pt-layout
    grid-template-columns: 1fr !important
    gap: $space-lg
    width: 100%
    max-width: none
    margin-left: 0
    margin-right: 0
    padding-left: $space-md
    padding-right: $space-md

  .pt-layout--right-sidebar,
  .pt-layout--left-sidebar
    grid-template-columns: 1fr !important

  .pt-layout__content
    max-width: none !important
    width: 100% !important
    min-width: 0

  .pt-card-grid
    width: 100% !important
    max-width: none !important
    grid-template-columns: minmax(0, 1fr)

  .pt-post-card
    width: 100% !important
    max-width: none !important
    min-width: 0 !important
    box-sizing: border-box

  .pt-layout__sidebar
    width: 100% !important
    max-width: 100% !important
    display: grid
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr))
    gap: $space-md

// ▼ Tablet (≤768px): tighter spacing, mobile header
+mq-tablet()
  .pt-main
    padding-top: "calc(%s + %s)" % ($header-height $space-lg)

  .pt-layout
    gap: $space-lg
    padding-left: $space-md
    padding-right: $space-md

  .pt-layout__sidebar
    grid-template-columns: 1fr

  // Header
  .pt-nav
    display: none

  .pt-header__menu-btn
    display: flex

// ▼ Mobile (≤640px): minimal
+mq-mobile()
  .pt-main
    padding-top: "calc(%s + %s)" % ($header-height $space-md)
    padding-left: 0 !important
    padding-right: 0 !important

  .pt-header__inner,
  .pt-footer__inner
    padding-left: $space-sm !important
    padding-right: $space-sm !important

  .pt-post-card
    border-radius: $radius-lg !important

    &__cover
      height: 180px

    &__body
      padding: $space-md

    &--text
      min-height: 220px

      .pt-post-card__title
        font-size: $font-scale-md
        margin: $space-md 0

  .pt-page-header__title
    font-size: $font-scale-md

  .pt-layout
    gap: $space-md
    padding-left: $space-sm
    padding-right: $space-sm

  .pt-card-grid
    gap: $space-md

@media (max-width: 420px)
  .pt-post-card__cover
    height: 160px
