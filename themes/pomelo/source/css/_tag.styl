// ===================================
// Pomelo Theme — Tag & Category
// ===================================
@import '_variables'

.pt-tag
  display: inline-flex
  align-items: center
  min-height: 24px
  padding: 0 $space-sm
  border-radius: $radius-sm
  font-size: $font-scale-xs
  font-family: $font-body
  font-weight: $font-wt-medium
  line-height: 1
  vertical-align: middle
  color: $clr-primary
  background: rgba(0, 255, 200, 0.08)
  border: 1px solid rgba(0, 255, 200, 0.12)
  transition: color $transition-fast, background $transition-fast, border-color $transition-fast
  text-decoration: none

  &:hover
    background: rgba(0, 255, 200, 0.15)
    border-color: rgba(0, 255, 200, 0.3)
    color: $clr-primary
    text-decoration: none

  &--category
    color: $clr-accent
    background: rgba(255, 0, 136, 0.08)
    border-color: rgba(255, 0, 136, 0.12)
    &:hover
      background: rgba(255, 0, 136, 0.15)
      border-color: rgba(255, 0, 136, 0.3)

.pt-tag-cloud
  display: flex
  flex-wrap: wrap
  gap: 6px
  align-items: center
  padding: 0
